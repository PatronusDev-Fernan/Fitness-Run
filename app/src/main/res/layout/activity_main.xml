            <com.google.android.material.card.MaterialCardView android:id="@+id/userPostCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:visibility="gone" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:strokeColor="@color/fitnessrun_green" app:strokeWidth="1dp">
