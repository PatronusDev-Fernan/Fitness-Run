<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/historyRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fitnessrun_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="← Logros" android:textColor="@color/fitnessrun_text_primary" app:strokeColor="@color/fitnessrun_border" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Historial de progreso" android:textColor="@color/fitnessrun_text_primary" android:textSize="29sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tus actividades se organizan por cuenta y fecha." android:textColor="@color/fitnessrun_text_secondary" android:textSize="16sp" />
        <ProgressBar android:id="@+id/loadingIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_margin="28dp" />
        <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center" android:text="Todavía no hay actividades guardadas." android:textColor="@color/fitnessrun_text_secondary" android:visibility="gone" />
        <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite" android:textColor="@color/fitnessrun_text_primary" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/retryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cloud_retry" android:visibility="gone" />
        <LinearLayout android:id="@+id/historyContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
