<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/detailRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fitnessrun_background">
    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/actionBar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="16dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="← Atrás" android:textColor="@color/fitnessrun_text_primary" app:strokeColor="@color/fitnessrun_border" />
            <TextView android:id="@+id/categoryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_badge_green" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:textColor="@color/fitnessrun_green_dark" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/fitnessrun_text_primary" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/subtitleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/fitnessrun_text_secondary" android:textSize="16sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                <TextView android:id="@+id/metaOneText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_info_chip" android:gravity="center" android:padding="12dp" android:textColor="@color/fitnessrun_text_primary" android:textStyle="bold" />
                <TextView android:id="@+id/metaTwoText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_info_chip" android:gravity="center" android:padding="12dp" android:textColor="@color/fitnessrun_text_primary" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/fitnessrun_green_soft" app:cardCornerRadius="16dp" app:strokeColor="@color/fitnessrun_green" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/noticeTitleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/fitnessrun_green_dark" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/noticeDetailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/fitnessrun_text_primary" android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/contentTitleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:textColor="@color/fitnessrun_text_primary" android:textSize="21sp" android:textStyle="bold" />

            <LinearLayout android:id="@+id/itemsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:id="@+id/actionBar" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/white" android:elevation="8dp" android:orientation="horizontal" android:padding="14dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/secondaryButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:textColor="@color/fitnessrun_text_primary" app:strokeColor="@color/fitnessrun_border" />
        <com.google.android.material.button.MaterialButton android:id="@+id/primaryButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_weight="1.35" android:textColor="@color/white" app:backgroundTint="@color/fitnessrun_primary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
