<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/videosRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fitnessrun_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="← Logros" android:textColor="@color/fitnessrun_text_primary" app:strokeColor="@color/fitnessrun_border" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Videos desbloqueados" android:textColor="@color/fitnessrun_text_primary" android:textSize="29sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Aprende nuevas técnicas conforme avanzas de forma segura." android:textColor="@color/fitnessrun_text_secondary" android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" app:cardBackgroundColor="@color/fitnessrun_primary" app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TU BIBLIOTECA" android:textColor="#FFFFEDD5" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="2 videos disponibles" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Siguiente recompensa: completa 2 rutinas" android:textColor="@color/white" android:textSize="14sp" />
                <com.google.android.material.progressindicator.LinearProgressIndicator android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="14dp" android:max="10" android:progress="8" app:indicatorColor="@color/white" app:trackColor="#66FFFFFF" app:trackCornerRadius="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Disponibles ahora" android:textColor="@color/fitnessrun_text_primary" android:textSize="20sp" android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:strokeColor="@color/fitnessrun_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="132dp" android:background="@drawable/bg_video_warmup" android:gravity="center" android:text="▶" android:textColor="@color/white" android:textSize="42sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRIMER PASO · DESBLOQUEADO" android:textColor="@color/fitnessrun_green_dark" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Calentamiento antes de entrenar" android:textColor="@color/fitnessrun_text_primary" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Rutina guiada para preparar articulaciones y músculos." android:textColor="@color/fitnessrun_text_secondary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/playWarmupButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="Ver video" android:textColor="@color/white" app:backgroundTint="@color/fitnessrun_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:strokeColor="@color/fitnessrun_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONSTANCIA · DESBLOQUEADO" android:textColor="@color/fitnessrun_green_dark" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Movilidad para recuperación" android:textColor="@color/fitnessrun_text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Movimientos suaves para terminar tu sesión." android:textColor="@color/fitnessrun_text_secondary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/playMobilityButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="Ver video" android:textColor="@color/fitnessrun_primary" app:strokeColor="@color/fitnessrun_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="18dp" app:cardBackgroundColor="#FFF3F4F6" app:cardCornerRadius="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BLOQUEADO · 8 DE 10 RUTINAS" android:textColor="@color/fitnessrun_text_secondary" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Técnica de sentadilla" android:textColor="@color/fitnessrun_text_secondary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Completa 2 rutinas más para desbloquearlo." android:textColor="@color/fitnessrun_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
