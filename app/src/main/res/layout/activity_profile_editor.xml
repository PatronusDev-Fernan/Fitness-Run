<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/editorRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fitnessrun_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_edit_title" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/fitnessrun_text_primary" />
        <TextView android:id="@+id/accountBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/fitnessrun_green_dark" android:textStyle="bold" />
        <ImageView android:id="@+id/profilePhoto" android:layout_width="128dp" android:layout_height="128dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:scaleType="centerCrop" android:src="@drawable/fitnessrun_logo" android:contentDescription="@string/profile_photo_description" />
        <com.google.android.material.button.MaterialButton android:id="@+id/choosePhotoButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_photo_choose" />
        <com.google.android.material.button.MaterialButton android:id="@+id/removePhotoButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_photo_remove" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_photo_notice" android:textColor="@color/fitnessrun_text_secondary" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/register_name_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:maxLength="80" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/register_last_name_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editLastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:maxLength="80" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/food_goal">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/profile_bio_hint" app:counterEnabled="true" app:counterMaxLength="240">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:minLines="3" android:maxLength="240" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/demo_save" />
    </LinearLayout>
</ScrollView>
