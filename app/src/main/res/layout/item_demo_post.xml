<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="@color/white" app:strokeColor="@color/fitnessrun_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <ImageView android:id="@+id/postAvatar" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="8dp" android:scaleType="centerCrop" android:contentDescription="@string/profile_photo_description" />
        <TextView android:id="@+id/postAuthor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/fitnessrun_green_dark" android:textStyle="bold" />
        <TextView android:id="@+id/postBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/fitnessrun_text_primary" android:textSize="16sp" />
        <TextView android:id="@+id/postProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_badge_green" android:padding="14dp" android:textColor="@color/fitnessrun_green_dark" android:textStyle="bold" android:visibility="gone" />
        <ImageView android:id="@+id/postImage" android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="12dp" android:contentDescription="Fotografía compartida" android:scaleType="centerCrop" android:visibility="gone" />
        <VideoView android:id="@+id/postVideo" android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="12dp" android:background="@color/black" android:visibility="gone" />
        <TextView android:id="@+id/postVideoHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="8dp" android:text="Toca para reproducir o pausar" android:textColor="@color/fitnessrun_text_secondary" android:textSize="12sp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/postMediaButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

