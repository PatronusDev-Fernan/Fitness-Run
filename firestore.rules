rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function text(profile, field) {
      return !(field in profile) || (profile[field] is string && profile[field].size() <= 4096);
    }
    function accountType(profile) {
      return 'registration.account_type' in profile ? profile['registration.account_type'] : 'user';
    }
    function validProfile() {
      let data = request.resource.data;
      let p = data.profile;
      return data.keys().hasOnly(['profile', 'updatedAt'])
        && data.updatedAt == request.time
        && p is map
        && p.keys().hasAll(['registration.name', 'registration.last_name', 'registration.birth_date', 'registration.email'])
        && p.keys().hasOnly([
          'registration.name', 'registration.last_name', 'registration.birth_date', 'registration.email',
          'registration.height', 'registration.weight', 'registration.blood_type', 'registration.condition',
          'registration.injury', 'registration.allergy', 'registration.pain', 'registration.vegetables',
          'registration.fruits', 'registration.favorites', 'registration.dislikes', 'registration.restrictions',
          'registration.diet_type', 'registration.food_goal', 'registration.account_type', 'registration.bio', 'registration.photo'
        ])
        && p['registration.name'] is string && p['registration.name'].size() > 0 && p['registration.name'].size() <= 80
        && p['registration.last_name'] is string && p['registration.last_name'].size() > 0 && p['registration.last_name'].size() <= 80
        && p['registration.birth_date'] is string && p['registration.birth_date'].size() <= 80
        && p['registration.email'] == request.auth.token.email
        && text(p, 'registration.height') && text(p, 'registration.weight') && text(p, 'registration.blood_type')
        && text(p, 'registration.condition') && text(p, 'registration.injury') && text(p, 'registration.allergy')
        && text(p, 'registration.pain') && text(p, 'registration.vegetables') && text(p, 'registration.fruits')
        && text(p, 'registration.favorites') && text(p, 'registration.dislikes') && text(p, 'registration.restrictions')
        && text(p, 'registration.diet_type') && text(p, 'registration.food_goal')
        && accountType(p) in ['user', 'coach']
        && (!('registration.bio' in p) || (p['registration.bio'] is string && p['registration.bio'].size() <= 240))
        && (!('registration.photo' in p) || (p['registration.photo'] is string && p['registration.photo'].size() <= 60000
          && (p['registration.photo'] == '' || p['registration.photo'].matches('/9j/[A-Za-z0-9+/]*={0,2}'))));
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && validProfile();
      // Account type is a self-declared label, not a privileged role. Legacy profiles remain users.
      allow update: if owner(uid) && validProfile()
        && accountType(request.resource.data.profile) == accountType(resource.data.profile);
      allow delete: if owner(uid);
      match /dailyProgress/{date} {
        function validProgress() {
          let d = request.resource.data;
          let c = d.exerciseChecks;
          return d.keys().hasAll(['date', 'completedRoutines', 'completedMeals', 'exerciseChecks', 'weekendRoutine', 'weekendFood', 'updatedAt'])
            && d.keys().hasOnly(['date', 'completedRoutines', 'completedMeals', 'exerciseChecks', 'weekendRoutine', 'weekendFood', 'updatedAt'])
            && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.date == date
            && d.updatedAt == request.time
            && d.completedRoutines is list && d.completedRoutines.size() <= 2 && d.completedRoutines.hasOnly([0, 1])
            && d.completedRoutines.size() == d.completedRoutines.toSet().size()
            && d.completedMeals is list && d.completedMeals.size() <= 4 && d.completedMeals.hasOnly([0, 1, 2, 3])
            && d.completedMeals.size() == d.completedMeals.toSet().size()
            && c is map && c.keys().hasOnly(['0', '1'])
            && (!('0' in c) || (c['0'] is list && c['0'].size() <= 3 && c['0'].hasOnly([0, 1, 2]) && c['0'].size() == c['0'].toSet().size()))
            && (!('1' in c) || (c['1'] is list && c['1'].size() <= 2 && c['1'].hasOnly([0, 1]) && c['1'].size() == c['1'].toSet().size()))
            && (!(0 in d.completedRoutines) || ('0' in c && c['0'].hasAll([0, 1, 2])))
            && (!(1 in d.completedRoutines) || ('1' in c && c['1'].hasAll([0, 1])))
            && d.weekendRoutine in ['Sin seleccionar', 'Descanso', 'Caminata', 'Estiramiento', 'Actividad libre']
            && d.weekendFood in ['Sin seleccionar', 'Mantener el menú semanal', 'Comida flexible planificada', 'Elegir alternativas seguras'];
        }
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validProgress();
      }
    }
    // Everything else, including accessing other users' profiles or progress, is denied.
  }
}
